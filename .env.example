# =============================================================================
# FamilyPulse – Environment Variables
# Copy to `.env.local` for local development. NEVER commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# See docs/environment.md for where to obtain each value.
# =============================================================================

# ---- Public (browser-visible, non-secret) -----------------------------------
# Public base URL of the app, without trailing slash (e.g. https://familypulse.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Supabase project URL (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_…) – safe for the browser, RLS protects data
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "true" = isolated demo mode with synthetic data; no Supabase/provider calls are made.
NEXT_PUBLIC_DEMO_MODE=false

# ---- Server-only secrets ----------------------------------------------------
# Supabase secret / service-role key (sb_secret_… or legacy service_role JWT). Bypasses RLS!
SUPABASE_SERVICE_ROLE_KEY=

# WHOOP Developer Dashboard → your app (https://developer-dashboard.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URL registered in the WHOOP dashboard
WHOOP_REDIRECT_URI=http://localhost:3000/api/whoop/callback

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/google-health/callback
# Full value of the Authorization header Google Health sends to our webhook,
# including the scheme, e.g. "Bearer <random>". Generate with `npm run generate:key`.
GOOGLE_HEALTH_WEBHOOK_AUTHORIZATION=

# 32-byte key, base64 encoded, for AES-256-GCM encryption of OAuth tokens (npm run generate:key)
TOKEN_ENCRYPTION_KEY=
# Optional: previous key during key rotation (decrypt-only)
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Random secret (>= 32 chars) protecting /api/sync/cron (Vercel Cron sends it as Bearer token)
CRON_SECRET=
